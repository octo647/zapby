[Unit]
Description=Laravel Queue Worker
After=network.target

[Service]
Type=simple
User=helder
WorkingDirectory=/var/www/zapby
ExecStart=/usr/bin/php /var/www/zapby/artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=10

StandardOutput=append:/var/www/zapby/storage/logs/queue-worker.log
StandardError=append:/var/www/zapby/storage/logs/queue-worker.log

[Install]
WantedBy=multi-user.target
