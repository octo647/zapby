// Funçoes de registro e erros
//
function info(...args) {
    console.log(
        new Date().toLocaleString('pt-BR'),
        ...args
    );
}

function error(...args) {
    console.error(
        new Date().toLocaleString('pt-BR'),
        ...args
    );
}

/**
 * Envia mensagem com retry automático em caso de conexão perdida
 */
async function sendMessageWithRetry(sock, remoteJid, message, retries = 0) {
    try {
        return await sock.sendMessage(remoteJid, message)
    } catch (error) {
        const isConnectionError = error.message?.includes('Connection') || 
                                   error.output?.statusCode === 428 ||
                                   error.output?.statusCode === 440
        
        if (retries < MAX_RETRIES && isConnectionError) {
            console.log(`⚠️ Erro de conexão (tentativa ${retries + 1}/${MAX_RETRIES}), aguardando ${RETRY_DELAY}ms...`)
            await new Promise(resolve => setTimeout(resolve, RETRY_DELAY))
            return sendMessageWithRetry(sock, remoteJid, message, retries + 1)
        }
        throw error
    }
}

function loadSessions() {
    try {
        if (fs.existsSync(SESSIONS_FILE)) {
            const data = JSON.parse(fs.readFileSync(SESSIONS_FILE, 'utf8'));
            Object.entries(data).forEach(([phone, session]) => {
                sessions.set(phone, session);
            });
            console.log(`📂 ${sessions.size} sessões carregadas`);
        }
    } catch (error) {
        console.error('❌ Erro ao carregar sessões:', error);
    }
}

function saveSessions() {
    try {
        const data = Object.fromEntries(sessions);
        fs.writeFileSync(SESSIONS_FILE, JSON.stringify(data, null, 2));
    } catch (error) {
        console.error('❌ Erro ao salvar sessões:', error);
    }
}

function getSession(phone) {
    return sessions.get(phone) || null;
}

function setSession(phone, data) {
    sessions.set(phone, { ...data, updated_at: new Date().toISOString() });
    saveSessions();
}

function clearSession(phone) {
    sessions.delete(phone);
    saveSessions();
}

// Funções auxiliares para mensagens interativas

/**
 * Envia uma lista interativa do WhatsApp
 */
async function sendList(sock, remoteJid, title, description, buttonText, sections) {
    // Baileys não suporta listas interativas oficiais
    // Vamos usar formatação de texto otimizada e elegante
    let message = `*${title}*\n\n${description}\n`;
    
    sections.forEach((section) => {
        message += `\n━━━━━━━━━━━━━━━\n`;
        if (section.title) {
            message += `*${section.title}*\n\n`;
        }
        section.rows.forEach(row => {
            message += `*[${row.rowId}]* ${row.title}\n`;
            if (row.description) {
                message += `    └ ${row.description}\n`;
            }
            message += `\n`;
        });
    });
    
    message += `━━━━━━━━━━━━━━━\n`;
    
    await sendMessageWithRetry(sock, remoteJid, { text: message });
    info('✅ Lista formatada enviada');
}

/**
 * Envia botões interativos do WhatsApp
 */
async function sendButtons(sock, remoteJid, title, description, buttons) {
    // Baileys não suporta botões interativos oficiais
    // Vamos usar formatação de texto otimizada
    let message = `*${title}*\n\n${description}\n`;
    message += `\n━━━━━━━━━━━━━━━\n`;
    
    buttons.forEach((btn, idx) => {
        message += `*[${idx + 1}]* ${btn.text}\n`;
    });
    
    message += `━━━━━━━━━━━━━━━\n`;
    message += `\n_Digite o número da sua escolha_`;
    
    await sendMessageWithRetry(sock, remoteJid, { text: message });
    info('✅ Botões formatados enviados');
}

